# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ─────────────────────────────────────────────────────────────────────────────
# Release signing - never commit any of this.
# The copies inside android/ are also ignored by android/.gitignore; the
# patterns below catch a keystore that ends up anywhere else in the tree.
# ─────────────────────────────────────────────────────────────────────────────
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
key.properties
keystore.properties

# Passwords written to a file beside the keystore, and the base64 blob a
# setup helper leaves behind when uploading MUSIX_KEYSTORE_BASE64. The
# keystore itself is kept outside this tree entirely; these catch a copy that
# wanders in, so a stray `pass.txt` cannot become a commit.
pass.txt
credentials.txt
keystore.b64

# Build output that must never be committed: the release workflow builds the
# APK and attaches it to the GitHub Release instead.
/*.apk
/*.aab
*.idsig

# Downloaded update staging (runtime only, but keep it out of git)
updates/
